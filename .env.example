# Copy to .env (git-ignored) for local development.
# Generate a key: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
# DEBUG defaults to False; set to 1 only for local development.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Leave POSTGRES_DB empty to use SQLite.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=django-db
MAX_OBSERVATION_AGE_MIN=120
DJANGO_LOG_LEVEL=INFO
